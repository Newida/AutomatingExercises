#!/usr/bin/env python3
"""auto_exercises: exercise sheet PDF -> solution directory, solved by an agent."""
import argparse, hashlib, json, os, shutil, subprocess, sys, time
from pathlib import Path

ROOT = Path(os.path.realpath(__file__)).parent.parent
PROMPT = ROOT / "prompts" / "solve.md"
CHECK_PROMPT = ROOT / "prompts" / "check_inputs.md"
SLIDES_PROMPT = ROOT / "prompts" / "slides.md"
TEMPLATE = ROOT / "templates" / "slides"
BUILD = ROOT / "bin" / "build_slides"
WAITING = "WAITING_FOR_INPUTS"  # marker file: input check failed, folder may be reused
VENV_PY = ROOT / ".venv" / "bin" / "python"


def stop(msg, code=1):
    print(f"auto_exercises: STOP: {msg}", file=sys.stderr)
    sys.exit(code)


def same_sheet(pdf, out):
    old = out / "source" / "sheet.pdf"
    return old.is_file() and hashlib.sha256(old.read_bytes()).digest() == hashlib.sha256(pdf.read_bytes()).digest()


def prepare(pdf, out, force):
    """Create the folder. Returns None if an existing folder waiting for inputs is reused."""
    if out.exists():
        if not force and (out / WAITING).exists() and same_sheet(pdf, out):
            return None
        if not force:
            stop(f"{out} already exists (use --force to replace it)")
        shutil.rmtree(out)
    src = out / "source"
    (src / "pages").mkdir(parents=True)
    for d in ("solutions", "code", "figures"):
        (out / d).mkdir()
    shutil.copy2(pdf, src / "sheet.pdf")
    for cmd in (["pdftotext", "-layout", str(src / "sheet.pdf"), str(src / "sheet.txt")],
                ["pdftoppm", "-r", "110", "-png", str(src / "sheet.pdf"), str(src / "pages" / "page")]):
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode:
            stop(f"{cmd[0]} failed: {r.stderr.strip()}")
    pages = sorted((src / "pages").glob("*.png"))
    text = (src / "sheet.txt").read_text(errors="replace")
    if len(text.split()) < 20:
        print("auto_exercises: warning: almost no text extracted (scanned PDF?); the agent will rely on page images.")
    return len(pages)


def short(s, n=110):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def show(event, t0):
    """Print a one-line progress message for an agent stream-json event."""
    stamp = time.strftime("%M:%S", time.gmtime(time.time() - t0))
    if event.get("type") == "assistant":
        for c in event.get("message", {}).get("content", []):
            if c.get("type") == "text" and c.get("text", "").strip():
                print(f"[{stamp}] {short(c['text'])}", flush=True)
            elif c.get("type") == "tool_use":
                inp = c.get("input", {})
                arg = inp.get("file_path") or inp.get("command") or inp.get("description") or ""
                print(f"[{stamp}]   -> {c.get('name')}: {short(arg, 90)}", flush=True)
    elif event.get("type") == "result":
        cost = event.get("total_cost_usd")
        print(f"[{stamp}] agent finished ({event.get('subtype')}, {event.get('num_turns')} turns"
              + (f", ~${cost:.2f} API-equivalent" if cost else "") + ")", flush=True)


def run_claude(out, prompt, model, effort, logname="agent.log"):
    """Run one agent; on failure stop at once and print the agent's own error message."""
    cmd = ["claude", "-p", prompt, "--output-format", "stream-json", "--verbose",
           "--permission-mode", "bypassPermissions",
           "--disallowedTools", "WebFetch", "WebSearch"]
    if model:
        cmd += ["--model", model]
    if effort:
        cmd += ["--effort", effort]
    t0 = time.time()
    errors, failed = [], False  # non-JSON output (CLI errors, warnings) and error results
    with open(out / logname, "w") as log:
        p = subprocess.Popen(cmd, cwd=out, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        try:
            for line in p.stdout:
                log.write(line); log.flush()
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    print(short(line), flush=True)
                    if line.strip():
                        errors.append(line.strip())
                    continue
                show(event, t0)
                if event.get("type") == "result" and event.get("is_error"):
                    failed = True
                    errors += [str(e) for e in event.get("errors") or []] or [str(event.get("result") or event.get("subtype"))]
            rc = p.wait()
        except KeyboardInterrupt:
            p.terminate(); p.wait()
            stop(f"interrupted; partial results in {out}", 130)
    if rc or failed:
        stop(f"agent failed (exit code {rc}); see {out / logname}\n" + "\n".join(errors[-10:]))


def installed_packages():
    r = subprocess.run([str(VENV_PY), "-m", "pip", "list", "--format=json"], capture_output=True, text=True)
    return sorted(p["name"].lower() for p in json.loads(r.stdout or "[]"))


def find_file(name, dirs):
    """Look for a file by name (case-insensitive): top level of the sheet's folder, anywhere below data dirs."""
    for d, deep in dirs:
        if not d.is_dir():
            continue
        for f in (d.rglob("*") if deep else d.iterdir()):
            if f.is_file() and f.name.lower() == name.lower():
                return f
    return None


def check_inputs(out, pdf, data_dirs, model, effort):
    """Ask an agent what the sheet needs, then check it is all there. Stops (exit 2) with a list if not."""
    req_file = out / "source" / "requirements.json"
    if not req_file.exists():
        print("auto_exercises: checking what the sheet needs (data files, packages) ...")
        prompt = (CHECK_PROMPT.read_text().replace("{python}", str(VENV_PY))
                  .replace("{packages}", ", ".join(installed_packages())))
        run_claude(out, prompt, model, effort, "check.log")
        if not req_file.exists():
            stop(f"input check failed (no requirements.json); see {out / 'check.log'}")
    try:
        req = json.loads(req_file.read_text())
        files, pkgs = req.get("files", []), req.get("packages", [])
    except (json.JSONDecodeError, AttributeError) as e:
        stop(f"bad {req_file}: {e}")

    dirs = [(pdf.parent, False), (pdf.parent / f"{pdf.stem}_data", True)] + [(d, True) for d in data_dirs]
    found, missing = {}, []
    for f in files:
        hit = find_file(f["name"], dirs)
        (found.__setitem__(f["name"], hit) if hit else missing.append(f))
    have = set(installed_packages())
    missing_pkgs = [p for p in pkgs if p["name"].lower().replace("_", "-") not in have]

    for name, path in found.items():
        print(f"  ok   {name}  ({path})")
    for p in pkgs:
        if p not in missing_pkgs:
            print(f"  ok   python package {p['name']}")
    if not missing and not missing_pkgs:
        (out / WAITING).unlink(missing_ok=True)
        (out / "data").mkdir(exist_ok=True)
        for name, path in found.items():
            shutil.copy2(path, out / "data" / name)
        print(f"auto_exercises: all inputs present ({len(files)} files, {len(pkgs)} packages).")
        return

    (out / WAITING).write_text("Input check failed; rerun auto_exercises once the inputs are there.\n")
    print("\nauto_exercises: STOP: the sheet needs things I do not have. Nothing has been solved yet.\n", file=sys.stderr)
    for f in missing:
        print(f"  MISSING file {f['name']}  (tasks {', '.join(f.get('tasks') or ['?'])}): {f.get('what') or ''}", file=sys.stderr)
        if f.get("where"):
            print(f"      sheet says: {f['where']}", file=sys.stderr)
        if f.get("note"):
            print(f"      note: {f['note']}", file=sys.stderr)
    for p in missing_pkgs:
        print(f"  MISSING python package {p['name']}  (tasks {', '.join(p.get('tasks') or ['?'])}): {p.get('why') or ''}", file=sys.stderr)
    print(f"\nPut the files next to the PDF, in {pdf.parent / (pdf.stem + '_data')}/, or pass --data DIR.", file=sys.stderr)
    if missing_pkgs:
        print(f"Install packages with: {VENV_PY.parent / 'pip'} install " + " ".join(p["name"] for p in missing_pkgs), file=sys.stderr)
    print(f"Then rerun the same command. (Wrong list? Edit {req_file}, or --force to check from scratch.)", file=sys.stderr)
    sys.exit(2)


def make_slides(out, model, effort):
    """Copy the slide template into out/slides, let an agent fill it, then build and check the PDF."""
    sl = out / "slides"
    if sl.exists():
        shutil.rmtree(sl)
    sl.mkdir()
    for f in ("slides.tex", "exslides.sty"):
        shutil.copy2(TEMPLATE / f, sl / f)
    prompt = (SLIDES_PROMPT.read_text().replace("{build}", str(BUILD))
              .replace("{pattern}", (TEMPLATE / "pattern.md").read_text()))
    (out / "source" / "slides_prompt.md").write_text(prompt)
    print("auto_exercises: making slides from the solutions (log in slides.log) ...")
    run_claude(out, prompt, model, effort, "slides.log")
    b = subprocess.run([str(BUILD), str(sl)], capture_output=True, text=True)
    print(b.stdout, end="")
    if b.returncode:
        stop(f"slides do not build cleanly; see {sl / 'build'}")
    print(f"auto_exercises: slides: {sl / 'slides.pdf'}\n  notes: {sl / 'NOTES.md'}")


def main():
    ap = argparse.ArgumentParser(
        prog="auto_exercises",
        description="Solve every exercise on a sheet with an AI agent. "
                    "Creates <sheet>_solutions/ next to the PDF with exercises.md, "
                    "solutions/, code/, figures/, REPORT.md and slides/ (slides.pdf).")
    ap.add_argument("pdf", help="path to the exercise sheet PDF")
    ap.add_argument("--model", help="Claude model (default: Claude Code's default)")
    ap.add_argument("--effort", choices=["low", "medium", "high", "xhigh", "max"],
                    help="reasoning effort for every agent run (default: Claude Code's setting)")
    ap.add_argument("--force", action="store_true", help="replace an existing solution directory")
    ap.add_argument("--data", action="append", default=[], metavar="DIR",
                    help="extra folder to search for data files the sheet needs (repeatable)")
    ap.add_argument("--slides-only", action="store_true",
                    help="only (re)make the slides from an existing, solved solution directory")
    ap.add_argument("--dry-run", action="store_true", help="prepare the directory and print the prompt, but do not start the agent")
    a = ap.parse_args()

    pdf = Path(a.pdf).expanduser().resolve()
    if not pdf.is_file():
        stop(f"no such file: {a.pdf}")
    if pdf.suffix.lower() != ".pdf":
        stop(f"not a PDF: {a.pdf}")
    info = subprocess.run(["pdfinfo", str(pdf)], capture_output=True, text=True)
    if info.returncode:
        stop(f"cannot read PDF: {info.stderr.strip()}")
    if "Encrypted:       yes" in info.stdout:
        stop("PDF is encrypted")
    if not VENV_PY.exists():
        stop(f"Python environment missing: {VENV_PY}")
    if not a.dry_run and not shutil.which("claude"):
        stop("claude CLI not found on PATH")

    out = pdf.parent / f"{pdf.stem}_solutions"
    if a.slides_only:
        if not (out / "REPORT.md").exists():
            stop(f"{out} is not solved yet (no REPORT.md); run without --slides-only first")
        make_slides(out, a.model, a.effort)
        return
    n = prepare(pdf, out, a.force)
    prompt = PROMPT.read_text().replace("{python}", str(VENV_PY))
    (out / "source" / "prompt.md").write_text(prompt)
    if n is None:
        print(f"auto_exercises: {pdf.name}: reusing {out} (was waiting for inputs)")
    else:
        print(f"auto_exercises: {pdf.name}: {n} pages -> {out}")
    if a.dry_run:
        print(prompt)
        return
    check_inputs(out, pdf, [Path(d).expanduser().resolve() for d in a.data], a.model, a.effort)
    print("auto_exercises: solving; no human in the loop from here on.")
    print("auto_exercises: starting agent (Ctrl-C to abort; full log in agent.log)")
    run_claude(out, prompt, a.model, a.effort)
    if not (out / "REPORT.md").exists():
        stop(f"agent finished without REPORT.md; see {out / 'agent.log'}")
    print(f"auto_exercises: solved. Report: {out / 'REPORT.md'}")
    make_slides(out, a.model, a.effort)
    print(f"\nauto_exercises: done. Everything in {out}")


if __name__ == "__main__":
    main()
