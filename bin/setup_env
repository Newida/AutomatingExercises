#!/usr/bin/env bash
# Create or update the solver environment .venv/ from env/requirements.txt.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# base interpreter: $PYTHON, else python3.12 on PATH (e.g. installed with `uv python install 3.12`)
BASE="${PYTHON:-$(command -v python3.12 || ls "$HOME"/.local/share/uv/python/cpython-3.12*/bin/python3.12 2>/dev/null | head -1)}"
[ -n "$BASE" ] && [ -x "$BASE" ] || { echo "setup_env: no Python 3.12 found; install one or set PYTHON=/path/to/python3.12"; exit 1; }
[ -x "$ROOT/.venv/bin/python" ] || "$BASE" -m venv "$ROOT/.venv"
PIP="$ROOT/.venv/bin/python -m pip"
$PIP install -q --upgrade pip
$PIP install -q --extra-index-url https://download.pytorch.org/whl/cpu -r "$ROOT/env/requirements.txt"
"$ROOT/.venv/bin/python" - <<'PY'
import numpy, scipy, sympy, pandas, matplotlib, seaborn, sklearn, jax, torch, torchvision, csv
print("env ok:", "python", __import__("sys").version.split()[0], "| numpy", numpy.__version__,
      "| jax", jax.__version__, "| torch", torch.__version__, "| pandas", pandas.__version__)
PY
